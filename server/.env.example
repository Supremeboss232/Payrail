# =============================================================================
# PAYRAIL CLEARINGHOUSE & BaaS GATEWAY — ENVIRONMENT CONFIGURATION
# Copy this file to `.env` in the `server/` directory.
# All external vendor keys are OPTIONAL in local/institutional mode.
# =============================================================================

# Server Network Configuration
PORT=9500
HOST=127.0.0.95
APP_BASE_URL=http://127.0.0.90:9000

# Security & Cryptography Secrets
JWT_SECRET=payrail_sovereign_jwt_signing_secret_change_in_prod
MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ADMIN_DEFAULT_PASSWORD=admin123

# Database Engines (Defaults to local SQLite vault.db and rail.db if omitted)
# TURSO_VAULT_URL=libsql://your-vault.turso.io
# TURSO_VAULT_TOKEN=your_turso_vault_token
# NILE_DATABASE_URL=postgres://user:pass@us-west-2.db.thenile.dev:5432/payrail

# Optional External BaaS Vendor API Keys (System uses built-in engines if omitted)
# FIXER_IO_API_KEY=your_fixer_io_key
# SENDGRID_API_KEY=SG.your_sendgrid_api_key
# SENDGRID_FROM_EMAIL=noreply@payrail.io
# COMPLY_ADVANTAGE_API_KEY=your_complyadvantage_key
# CRYPTO_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your_api_key
# MARQETA_BASE_URL=https://sandbox-api.marqeta.com/v3
# MARQETA_APP_TOKEN=your_marqeta_app_token
# MARQETA_ADMIN_TOKEN=your_marqeta_admin_token
# ACH_ROUTING_NUMBER=021000021
# EQUIFAX_CLIENT_ID=your_equifax_client_id
# EQUIFAX_CLIENT_SECRET=your_equifax_client_secret
